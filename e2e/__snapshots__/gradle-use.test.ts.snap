// Jest Snapshot v1, https://goo.gl/fbAQLP

exports[`Bash .java-version and .gradle-version coexist in one directory: Bash 1`] = `
"set -e
eval "$(fjm env)"
fjm use
if [ "$(java --version)" != 'openjdk version "17.0.2"' ]; then
  echo "Expected java version to be 'openjdk version "17.0.2"'. Got $(java --version)"
  exit 1
fi
fjm use --tool gradle
if [ "$(gradle --version)" != 'Gradle 8.10.0' ]; then
  echo "Expected gradle version to be 'Gradle 8.10.0'. Got $(gradle --version)"
  exit 1
fi"
`;

exports[`Bash alias/unalias, default, and current work for --tool gradle: Bash 1`] = `
"set -e
eval "$(fjm env)"
fjm alias 8.10.0 my-gradle --tool gradle
fjm default 8.10.0 --tool gradle
fjm use --tool gradle 8.10.0
if [ "$(gradle --version)" != 'Gradle 8.10.0' ]; then
  echo "Expected gradle version to be 'Gradle 8.10.0'. Got $(gradle --version)"
  exit 1
fi
fjm unalias my-gradle --tool gradle
if [ "$(fjm current --tool gradle)" != 'v8.10.0' ]; then
  echo "Expected fjm current --tool gradle to be 'v8.10.0'. Got $(fjm current --tool gradle)"
  exit 1
fi"
`;

exports[`Bash use --tool gradle activates Gradle without disturbing Java: Bash 1`] = `
"set -e
eval "$(fjm env)"
fjm use 17.0.2
if [ "$(java --version)" != 'openjdk version "17.0.2"' ]; then
  echo "Expected java version to be 'openjdk version "17.0.2"'. Got $(java --version)"
  exit 1
fi
fjm use --tool gradle 8.10.0
if [ "$(gradle --version)" != 'Gradle 8.10.0' ]; then
  echo "Expected gradle version to be 'Gradle 8.10.0'. Got $(gradle --version)"
  exit 1
fi
if [ "$(java --version)" != 'openjdk version "17.0.2"' ]; then
  echo "Expected java version to be 'openjdk version "17.0.2"'. Got $(java --version)"
  exit 1
fi"
`;

exports[`Bash use --tool gradle works with no Java version active: Bash 1`] = `
"set -e
eval "$(fjm env)"
fjm use --tool gradle 8.10.0
if [ "$(gradle --version)" != 'Gradle 8.10.0' ]; then
  echo "Expected gradle version to be 'Gradle 8.10.0'. Got $(gradle --version)"
  exit 1
fi"
`;

exports[`Fish .java-version and .gradle-version coexist in one directory: Fish 1`] = `
"fjm env | source
fjm use
set ____test____ (java --version)
if test "$____test____" != 'openjdk version "17.0.2"'
  echo "Expected java version to be 'openjdk version "17.0.2"'. Got $____test____"
  exit 1
end
fjm use --tool gradle
set ____test____ (gradle --version)
if test "$____test____" != 'Gradle 8.10.0'
  echo "Expected gradle version to be 'Gradle 8.10.0'. Got $____test____"
  exit 1
end"
`;

