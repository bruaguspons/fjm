exports[`PowerShell .java-version and .gradle-version coexist in one directory: PowerShell 1`] = `
"$ErrorActionPreference = "Stop"
fjm env | Out-String | Invoke-Expression
fjm use
if ( "$(java --version)" -ne 'openjdk version "17.0.2"' ) { echo "Expected java version to be 'openjdk version "17.0.2"'. Got $(java --version)"; exit 1 }
fjm use --tool gradle
if ( "$(gradle --version)" -ne 'Gradle 8.10.0' ) { echo "Expected gradle version to be 'Gradle 8.10.0'. Got $(gradle --version)"; exit 1 }"
`;

