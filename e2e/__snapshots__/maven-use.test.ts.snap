// Jest Snapshot v1, https://goo.gl/fbAQLP

exports[`Bash .java-version and .maven-version coexist in one directory: Bash 1`] = `
"set -e
eval "$(fjm env)"
fjm use
if [ "$(java --version)" != 'openjdk version "17.0.2"' ]; then
  echo "Expected java version to be 'openjdk version "17.0.2"'. Got $(java --version)"
  exit 1
fi
fjm use --tool maven
if [ "$(mvn --version)" != 'Apache Maven 3.9.9' ]; then
  echo "Expected maven version to be 'Apache Maven 3.9.9'. Got $(mvn --version)"
  exit 1
fi"
`;

exports[`Bash use --tool maven activates Maven without disturbing Java: Bash 1`] = `
"set -e
eval "$(fjm env)"
fjm use 17.0.2
if [ "$(java --version)" != 'openjdk version "17.0.2"' ]; then
  echo "Expected java version to be 'openjdk version "17.0.2"'. Got $(java --version)"
  exit 1
fi
fjm use --tool maven 3.9.9
if [ "$(mvn --version)" != 'Apache Maven 3.9.9' ]; then
  echo "Expected maven version to be 'Apache Maven 3.9.9'. Got $(mvn --version)"
  exit 1
fi
if [ "$(java --version)" != 'openjdk version "17.0.2"' ]; then
  echo "Expected java version to be 'openjdk version "17.0.2"'. Got $(java --version)"
  exit 1
fi"
`;

exports[`Bash use --tool maven works with no Java version active: Bash 1`] = `
"set -e
eval "$(fjm env)"
fjm use --tool maven 3.9.9
if [ "$(mvn --version)" != 'Apache Maven 3.9.9' ]; then
  echo "Expected maven version to be 'Apache Maven 3.9.9'. Got $(mvn --version)"
  exit 1
fi"
`;

exports[`Fish .java-version and .maven-version coexist in one directory: Fish 1`] = `
"fjm env | source
fjm use
set ____test____ (java --version)
if test "$____test____" != 'openjdk version "17.0.2"'
  echo "Expected java version to be 'openjdk version "17.0.2"'. Got $____test____"
  exit 1
end
fjm use --tool maven
set ____test____ (mvn --version)
if test "$____test____" != 'Apache Maven 3.9.9'
  echo "Expected maven version to be 'Apache Maven 3.9.9'. Got $____test____"
  exit 1
end"
`;

