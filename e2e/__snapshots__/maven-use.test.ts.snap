exports[`PowerShell .java-version and .maven-version coexist in one directory: PowerShell 1`] = `
"$ErrorActionPreference = "Stop"
fjm env | Out-String | Invoke-Expression
fjm use
if ( "$(java --version)" -ne 'openjdk version "17.0.2"' ) { echo "Expected java version to be 'openjdk version "17.0.2"'. Got $(java --version)"; exit 1 }
fjm use --tool maven
if ( "$(mvn --version)" -ne 'Apache Maven 3.9.9' ) { echo "Expected maven version to be 'Apache Maven 3.9.9'. Got $(mvn --version)"; exit 1 }"
`;

exports[`PowerShell use --tool maven activates Maven without disturbing Java: PowerShell 1`] = `
"$ErrorActionPreference = "Stop"
fjm env | Out-String | Invoke-Expression
fjm use 17.0.2
if ( "$(java --version)" -ne 'openjdk version "17.0.2"' ) { echo "Expected java version to be 'openjdk version "17.0.2"'. Got $(java --version)"; exit 1 }
fjm use --tool maven 3.9.9
if ( "$(mvn --version)" -ne 'Apache Maven 3.9.9' ) { echo "Expected maven version to be 'Apache Maven 3.9.9'. Got $(mvn --version)"; exit 1 }
if ( "$(java --version)" -ne 'openjdk version "17.0.2"' ) { echo "Expected java version to be 'openjdk version "17.0.2"'. Got $(java --version)"; exit 1 }"
`;

exports[`PowerShell use --tool maven works with no Java version active: PowerShell 1`] = `
