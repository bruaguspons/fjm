// Jest Snapshot v1, https://goo.gl/fbAQLP

exports[`Bash \`exec\` usage: Bash 1`] = `
"set -e
if [ "$(fjm exec -- java --version)" != 'openjdk version "17.0.2"' ]; then
  echo "Expected version file exec to be 'openjdk version "17.0.2"'. Got $(fjm exec -- java --version)"
  exit 1
fi
if [ "$(fjm exec --using=11.0.21 -- java --version)" != 'openjdk version "11.0.21"' ]; then
  echo "Expected exec:11 java --version to be 'openjdk version "11.0.21"'. Got $(fjm exec --using=11.0.21 -- java --version)"
  exit 1
fi
if [ "$(fjm exec --using=21.0.1 -- java --version)" != 'openjdk version "21.0.1"' ]; then
  echo "Expected exec:21 java --version to be 'openjdk version "21.0.1"'. Got $(fjm exec --using=21.0.1 -- java --version)"
  exit 1
fi"
`;

exports[`Fish \`exec\` usage: Fish 1`] = `
"set ____test____ (fjm exec -- java --version)
if test "$____test____" != 'openjdk version "17.0.2"'
  echo "Expected version file exec to be 'openjdk version "17.0.2"'. Got $____test____"
  exit 1
end
set ____test____ (fjm exec --using=11.0.21 -- java --version)
if test "$____test____" != 'openjdk version "11.0.21"'
  echo "Expected exec:11 java --version to be 'openjdk version "11.0.21"'. Got $____test____"
  exit 1
end
set ____test____ (fjm exec --using=21.0.1 -- java --version)
if test "$____test____" != 'openjdk version "21.0.1"'
  echo "Expected exec:21 java --version to be 'openjdk version "21.0.1"'. Got $____test____"
  exit 1
end"
`;

exports[`PowerShell \`exec\` usage: PowerShell 1`] = `
"$ErrorActionPreference = "Stop"
if ( "$(fjm exec -- java --version)" -ne 'openjdk version "17.0.2"' ) { echo "Expected version file exec to be 'openjdk version "17.0.2"'. Got $(fjm exec -- java --version)"; exit 1 }
if ( "$(fjm exec --using=11.0.21 -- java --version)" -ne 'openjdk version "11.0.21"' ) { echo "Expected exec:11 java --version to be 'openjdk version "11.0.21"'. Got $(fjm exec --using=11.0.21 -- java --version)"; exit 1 }
if ( "$(fjm exec --using=21.0.1 -- java --version)" -ne 'openjdk version "21.0.1"' ) { echo "Expected exec:21 java --version to be 'openjdk version "21.0.1"'. Got $(fjm exec --using=21.0.1 -- java --version)"; exit 1 }"
`;

exports[`Zsh \`exec\` usage: Zsh 1`] = `
"set -e
if [ "$(fjm exec -- java --version)" != 'openjdk version "17.0.2"' ]; then
  echo "Expected version file exec to be 'openjdk version "17.0.2"'. Got $(fjm exec -- java --version)"
  exit 1
fi
if [ "$(fjm exec --using=11.0.21 -- java --version)" != 'openjdk version "11.0.21"' ]; then
  echo "Expected exec:11 java --version to be 'openjdk version "11.0.21"'. Got $(fjm exec --using=11.0.21 -- java --version)"
  exit 1
fi
if [ "$(fjm exec --using=21.0.1 -- java --version)" != 'openjdk version "21.0.1"' ]; then
  echo "Expected exec:21 java --version to be 'openjdk version "21.0.1"'. Got $(fjm exec --using=21.0.1 -- java --version)"
  exit 1
fi"
`;
