fjm env --log-level=error | Out-String | Invoke-Expression
$($__out__ = $(fjm use made-up-alias 2>&1 | Select-String 'Requested version made-up-alias is not'); if ($__out__ -eq $null) { exit 1 } else { $__out__ })"
`;

exports[`PowerShell unalias a version: PowerShell 1`] = `
"$ErrorActionPreference = "Stop"
fjm env | Out-String | Invoke-Expression
fjm alias 11.0.21 version11
$($__out__ = $(fjm ls | Select-String version11); if ($__out__ -eq $null) { exit 1 } else { $__out__ })
fjm unalias version11
$($__out__ = $(fjm use version11 2>&1 | Select-String 'Requested version version11 is not currently installed'); if ($__out__ -eq $null) { exit 1 } else { $__out__ })"
`;

exports[`PowerShell unalias errors if alias not found: PowerShell 1`] = `
