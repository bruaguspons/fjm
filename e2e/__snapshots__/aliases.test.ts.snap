exports[`PowerShell aliasing versions: PowerShell 1`] = `
"$ErrorActionPreference = "Stop"
fjm env | Out-String | Invoke-Expression
fjm alias 17.0.2 newer
fjm alias 11.0.21 older
fjm default older
$($__out__ = $($($__out__ = $(fjm ls | Select-String 17.0.2); if ($__out__ -eq $null) { exit 1 } else { $__out__ }) | Select-String newer); if ($__out__ -eq $null) { exit 1 } else { $__out__ })
$($__out__ = $($($__out__ = $(fjm ls | Select-String 11.0.21); if ($__out__ -eq $null) { exit 1 } else { $__out__ }) | Select-String older); if ($__out__ -eq $null) { exit 1 } else { $__out__ })
fjm use older
if ( "$(java --version)" -ne 'openjdk version "11.0.21"' ) { echo "Expected java version to be 'openjdk version "11.0.21"'. Got $(java --version)"; exit 1 }
fjm use newer
if ( "$(java --version)" -ne 'openjdk version "17.0.2"' ) { echo "Expected java version to be 'openjdk version "17.0.2"'. Got $(java --version)"; exit 1 }
fjm use default
if ( "$(java --version)" -ne 'openjdk version "11.0.21"' ) { echo "Expected java version to be 'openjdk version "11.0.21"'. Got $(java --version)"; exit 1 }"
`;

exports[`PowerShell can alias the system java: PowerShell 1`] = `
"$ErrorActionPreference = "Stop"
fjm env | Out-String | Invoke-Expression
fjm alias system my_system
$($__out__ = $(fjm ls | Select-String my_system); if ($__out__ -eq $null) { exit 1 } else { $__out__ })
fjm alias system default
fjm alias my_system my_system2
$($__out__ = $(fjm ls | Select-String my_system2); if ($__out__ -eq $null) { exit 1 } else { $__out__ })
$($__out__ = $(fjm use my_system | Select-String 'Bypassing fjm'); if ($__out__ -eq $null) { exit 1 } else { $__out__ })
fjm unalias my_system
$($__out__ = $(fjm use my_system 2>&1 | Select-String 'Requested version my_system is not currently installed'); if ($__out__ -eq $null) { exit 1 } else { $__out__ })"
`;

exports[`PowerShell errors when alias is not found: PowerShell 1`] = `
