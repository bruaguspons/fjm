// Jest Snapshot v1, https://goo.gl/fbAQLP

exports[`Bash installing from a .java-version with an unparseable lts codename falls back to no-version-in-file: Bash 1`] = `
"set -e
eval "$(fjm env)"
(fjm install 2>&1) | grep 'find version in dotfiles' || (echo "Expected output to contain 'find version in dotfiles'" && exit 1)"
`;

exports[`Fish installing from a .java-version with an unparseable lts codename falls back to no-version-in-file: Fish 1`] = `
"fjm env | source
begin; fjm install 2>&1; end | grep 'find version in dotfiles'; or echo "Expected output to contain 'find version in dotfiles'" && exit 1"
`;

exports[`PowerShell installing from a .java-version with an unparseable lts codename falls back to no-version-in-file: PowerShell 1`] = `
"$ErrorActionPreference = "Stop"
fjm env | Out-String | Invoke-Expression
$($__out__ = $(fjm install 2>&1 | Select-String 'find version in dotfiles'); if ($__out__ -eq $null) { exit 1 } else { $__out__ })"
`;

exports[`Zsh installing from a .java-version with an unparseable lts codename falls back to no-version-in-file: Zsh 1`] = `
"set -e
eval "$(fjm env)"
(fjm install 2>&1) | grep 'find version in dotfiles' || (echo "Expected output to contain 'find version in dotfiles'" && exit 1)"
`;
