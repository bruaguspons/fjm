exports[`Fish install --tool maven from .maven-version: Fish 1`] = `
"fjm env | source
fjm install --tool maven --use
set ____test____ (mvn --version)
if test "$____test____" != 'Apache Maven 3.9.9'
  echo "Expected maven version to be 'Apache Maven 3.9.9'. Got $____test____"
  exit 1
end"
`;

