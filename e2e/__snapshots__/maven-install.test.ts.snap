// Jest Snapshot v1, https://goo.gl/fbAQLP

exports[`Bash install --tool maven from .maven-version: Bash 1`] = `
"set -e
eval "$(fjm env)"
fjm install --tool maven --use
if [ "$(mvn --version)" != 'Apache Maven 3.9.9' ]; then
  echo "Expected maven version to be 'Apache Maven 3.9.9'. Got $(mvn --version)"
  exit 1
fi"
`;

exports[`Bash install --tool maven resolves against the fixture server: Bash 1`] = `
