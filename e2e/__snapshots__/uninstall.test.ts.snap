// Jest Snapshot v1, https://goo.gl/fbAQLP

exports[`Bash uninstalls a version: Bash 1`] = `
"set -e
fjm alias 17.0.2 hello
((fjm ls) | grep 17.0.2 || (echo "Expected output to contain 17.0.2" && exit 1)) | grep hello || (echo "Expected output to contain hello" && exit 1)
fjm uni hello
if [ "$(fjm ls)" != '* system' ]; then
  echo "Expected fjm ls to be '* system'. Got $(fjm ls)"
  exit 1
fi"
`;

exports[`Fish uninstalls a version: Fish 1`] = `
"fjm alias 17.0.2 hello
begin; begin; fjm ls; end | grep 17.0.2; or echo "Expected output to contain 17.0.2" && exit 1; end | grep hello; or echo "Expected output to contain hello" && exit 1
fjm uni hello
set ____test____ (fjm ls)
if test "$____test____" != '* system'
  echo "Expected fjm ls to be '* system'. Got $____test____"
  exit 1
end"
`;

exports[`PowerShell uninstalls a version: PowerShell 1`] = `
"$ErrorActionPreference = "Stop"
fjm alias 17.0.2 hello
$($__out__ = $($($__out__ = $(fjm ls | Select-String 17.0.2); if ($__out__ -eq $null) { exit 1 } else { $__out__ }) | Select-String hello); if ($__out__ -eq $null) { exit 1 } else { $__out__ })
fjm uni hello
if ( "$(fjm ls)" -ne '* system' ) { echo "Expected fjm ls to be '* system'. Got $(fjm ls)"; exit 1 }"
`;

exports[`Zsh uninstalls a version: Zsh 1`] = `
"set -e
fjm alias 17.0.2 hello
((fjm ls) | grep 17.0.2 || (echo "Expected output to contain 17.0.2" && exit 1)) | grep hello || (echo "Expected output to contain hello" && exit 1)
fjm uni hello
if [ "$(fjm ls)" != '* system' ]; then
  echo "Expected fjm ls to be '* system'. Got $(fjm ls)"
  exit 1
fi"
`;
